<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 target enables WinRT APIs (the native Share sheet). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApneScan.Studio</RootNamespace>
    <AssemblyName>ApneScan</AssemblyName>
    <ApplicationIcon>../NAPS2.Lib/Icons/favicon.ico</ApplicationIcon>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <Product>ApneScan</Product>
    <Title>ApneScan</Title>
    <Company>Subhash Kaler</Company>
    <Copyright>Copyright 2026 Subhash Kaler</Copyright>

    <!-- ApneScan version. Starts at 1.0.0 and is bumped on every update. -->
    <Version>1.0.74</Version>
    <AssemblyVersion>1.0.74.0</AssemblyVersion>
    <FileVersion>1.0.74.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web UI front-end (renders inside WebView2) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Real scanning engine + Windows image backend + PDF export -->
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <!-- OCR (Tesseract executable, bundled) -->
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.4.0" />
    <!-- QR code generation for Phone-to-PC -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="..\NAPS2.Sdk\NAPS2.Sdk.csproj" />
    <ProjectReference Include="..\NAPS2.Images.Gdi\NAPS2.Images.Gdi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ui.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- OCR language data (English) copied next to the app -->
    <None Update="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
