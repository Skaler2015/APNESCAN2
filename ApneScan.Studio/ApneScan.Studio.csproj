<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApneScan.Studio</RootNamespace>
    <AssemblyName>ApneScan</AssemblyName>
    <ApplicationIcon>../NAPS2.Lib/Icons/favicon.ico</ApplicationIcon>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <Product>ApneScan</Product>
    <Title>ApneScan</Title>
    <Company>Subhash Kaler</Company>
    <Copyright>Copyright 2026 Subhash Kaler</Copyright>

    <!-- ApneScan version. Starts at 1.0.0 and is bumped on every update. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web UI front-end (renders inside WebView2) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Real scanning engine + Windows image backend + PDF export -->
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <ProjectReference Include="..\NAPS2.Sdk\NAPS2.Sdk.csproj" />
    <ProjectReference Include="..\NAPS2.Images.Gdi\NAPS2.Images.Gdi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ui.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
